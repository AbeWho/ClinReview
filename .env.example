# Copy to .env.local and fill in. NEVER commit .env.local.

# Secret used to sign session cookies (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local demo sign-in with simulated personas. Defaults to enabled in development.
# In production it is OFF unless explicitly set to "true" (e.g. a public portfolio demo).
DEMO_AUTH_ENABLED=true

# Leave DATABASE_URL empty to use the embedded local Postgres (PGlite) stored in .data/pglite.
# Set it to a Postgres/Supabase connection string (server-side only!) to use a hosted database.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
