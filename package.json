{
  "name": "clinreview",
  "version": "0.1.0",
  "private": true,
  "description": "Medical AI evaluation & labeling workbench (portfolio project). For AI evaluation research and education. Not for diagnosis, treatment, or direct patient care.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
